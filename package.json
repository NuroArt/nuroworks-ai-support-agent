    "clsx": "2.1.1",
    "next": "15.5.28",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "unpdf": "^1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.2",
    "postcss": "8.5.32",
    "prisma": "7.10.1",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.32"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
