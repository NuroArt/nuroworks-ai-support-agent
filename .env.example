# ─── Database ────────────────────────────────────────────────
DATABASE_URL="postgresql://nuro:nuro@localhost:5432/nuroworks_support"

# ─── Telegram ────────────────────────────────────────────────
# From @BotFather
TELEGRAM_BOT_TOKEN=
# Any random string, 16+ chars. Telegram echoes it on every webhook call so
# forged posts are rejected.  openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=
# Staff group id. Create a private group, add the bot as admin, then forward a
# message from it to @userinfobot. Supergroup ids are negative.
TELEGRAM_ADMIN_CHAT_ID=

# ─── AI ──────────────────────────────────────────────────────
# Claude is primary. OpenAI is the fallback when Claude is unavailable.
# Set to `openai` to invert the order.
AI_PROVIDER=anthropic

# Required when AI_PROVIDER=anthropic (the default).
ANTHROPIC_API_KEY=

# Required ALWAYS, even on Claude: Anthropic has no embeddings endpoint, so the
# knowledge base depends on OpenAI. Also serves as the chat fallback.
OPENAI_API_KEY=

# Claude model for conversation. Verify against the current model list:
# https://platform.claude.com/docs/en/about-claude/models/overview
CHAT_MODEL=claude-sonnet-5-5
# Cheaper Claude model for intent classification and summaries — roughly 20x
# less per token, and those calls are the majority by volume.
FAST_MODEL=claude-haiku-5-5

# Used whenever OpenAI serves a request, as fallback or as primary.
OPENAI_CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ─── Admin dashboard ─────────────────────────────────────────
ADMIN_PASSWORD=
# openssl rand -hex 32
ADMIN_SESSION_SECRET=

# ─── App ─────────────────────────────────────────────────────
# Public https URL. Required to register the Telegram webhook.
APP_URL=https://support.nuroworks.com
NODE_ENV=development
